[diff]
exclude = ["scripts"]
[merge]
command = "meld"
{{ $email := promptStringOnce . "email" "What is your main git email address " }}
{{ $signingkey := promptStringOnce . "signingkey" "What is your git signing key " }}
{{ $hasNVim := promptBool "Do i install Neovim " false}}
{{ $hasDevel := promptBool "Do i install programming languages " false }}
{{ $hasLatex := promptBool "Do i install LaTeX " false }}
{{ $hasIDE := promptBool "Do i install IDE's " false }}
[git]
autoCommit = true
autoPush = true
[data]
hasNVim = {{ $hasNVim }}
hasDevel = {{ $hasDevel }}
hasLatex = {{ $hasLatex }}
hasIDE = {{ $hasIDE }}
email = {{ $email | quote }}
signingkey = {{ $signingkey | quote }}

